# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Banco (Supabase → botão "Connect" no topo do painel) ---
# App (Vercel/serverless): Transaction pooler, porta 6543
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrations e seed: Session pooler (porta 5432) ou conexão direta
DATABASE_URL_DIRETA=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Só desenvolvimento local, sem Supabase (npm run db:local) ---
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# AUTH_DESATIVADA=1   # ignorado em produção

# --- Só no deploy da DEMONSTRAÇÃO (banco Neon separado; copie para .env.demo) ---
# ATENÇÃO: NEXT_PUBLIC_MODO_DEMO desliga o login. Nunca no deploy do Krahe.
# NEXT_PUBLIC_MODO_DEMO=1
# NEXT_PUBLIC_DEMO_WHATSAPP=5551995859273
# DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# CRON_SECRET=uma-senha-longa        # o reset da madrugada (/api/demo/resetar) exige
